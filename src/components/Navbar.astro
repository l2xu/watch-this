---
import { Icon } from "astro-icon/components";
import LanguageToggle from "./LanguageToggle.astro";
---

<nav
	class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100"
>
	<div class="container mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex items-center justify-between h-16">
			<!-- Logo -->
			<a href="/" class="flex items-center gap-2 group">
				<img
					src="/logo.png"
					alt="WatchThis! Logo"
					class="h-8 w-auto transition-transform group-hover:scale-105"
				/>
				<span class="text-xl font-heading font-bold text-gray-900"
					><span class="text-primary">Watch</span>This!</span
				>
			</a>

			<!-- Store & GitHub Links & Language Toggle -->
			<div class="flex items-center gap-4">
				<a
					href="https://chromewebstore.google.com/detail/watchthis/hbpkmdcgckbogdkkepcnmgankbbjjlha"
					target="_blank"
					rel="noopener noreferrer"
					class="p-2 rounded-xl hover:bg-gray-100 transition-colors"
					aria-label="Chrome Web Store"
				>
					<Icon
						name="simple-icons:googlechrome"
						class="w-6 h-6 text-gray-700"
					/>
				</a>
				<a
					href="https://addons.mozilla.org/de/firefox/addon/watchthis/"
					target="_blank"
					rel="noopener noreferrer"
					class="p-2 rounded-xl hover:bg-gray-100 transition-colors"
					aria-label="Firefox Add-ons"
				>
					<Icon name="simple-icons:firefox" class="w-6 h-6 text-gray-700" />
				</a>
				<a
					href="https://github.com/l2xu/watch-this"
					target="_blank"
					rel="noopener noreferrer"
					class="p-2 rounded-xl hover:bg-gray-100 transition-colors"
					aria-label="GitHub Repository"
				>
					<Icon name="simple-icons:github" class="w-6 h-6 text-gray-700" />
				</a>

				<!-- Language Toggle -->
				<LanguageToggle />
			</div>
		</div>
	</div>
</nav>
