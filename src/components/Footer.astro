---
import { Icon } from "astro-icon/components";

const currentYear = new Date().getFullYear();

const socialLinks = [
	{
		name: "YouTube",
		href: "#",
		icon: "simple-icons:youtube",
	},
	{
		name: "GitHub",
		href: "#",
		icon: "simple-icons:github",
	},
	{
		name: "Website",
		href: "#",
		icon: "lucide:globe",
	},
	{
		name: "Ko-fi",
		href: "https://ko-fi.com/lukasweihrauch",
		icon: "simple-icons:kofi",
	},
];
---

<footer
	class="bg-linear-to-br from-primary via-primary to-primary-hover text-white py-16"
>
	<div class="container">
		<div class="flex justify-between items-center gap-12 mb-12">
			<!-- Brand -->
			<div>
				<a href="/" class="flex items-center gap-2 mb-4">
					<img
						src="/logo_white.png"
						alt="WatchThis! Logo"
						class="h-10 w-auto"
					/>
					<span class="text-2xl font-bold text-white">WatchThis!</span>
				</a>
				<p class="text-white/80 leading-relaxed">
					Share your favorite YouTube videos directly with friends.<br /> Free and
					privacy-focused.
				</p>
			</div>

			<!-- Install & Connect -->
			<div>
				<h3 class="font-semibold text-lg mb-4 text-white">Get Started</h3>
				<a
					href="#"
					class="inline-flex items-center justify-center px-6 py-3 bg-white text-primary font-semibold rounded-xl hover:bg-white/90 transition-colors mb-6"
				>
					<Icon name="lucide:download" class="w-5 h-5 mr-2" />
					Install Extension
				</a>

				<!-- Social Links -->
				<div class="flex items-center gap-4">
					{
						socialLinks.map((social) => (
							<a
								href={social.href}
								class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center text-white hover:bg-white hover:text-primary transition-all duration-300"
								aria-label={social.name}
							>
								<Icon name={social.icon} class="w-5 h-5" />
							</a>
						))
					}
				</div>
			</div>
		</div>

		<!-- Bottom Bar -->
		<div
			class="pt-8 border-t border-white/20 flex flex-col sm:flex-row items-center justify-between gap-4"
		>
			<p class="text-white/70 text-sm">
				© {currentYear} WatchThis! All rights reserved.
			</p>
			<div class="flex items-center gap-6 text-sm">
				<a
					href="/datenschutz"
					class="text-white/70 hover:text-white transition-colors"
				>
					Privacy Policy / Datenschutzerklärung
				</a>
				<a
					href="/impressum"
					class="text-white/70 hover:text-white transition-colors"
				>
					Legal Notice / Impressum
				</a>
			</div>
		</div>
	</div>
</footer>
