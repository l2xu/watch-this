---
// Replace with your actual YouTube video ID
const videoId = "dQw4w9WgXcQ";
---

<section id="video" class="py-20 bg-gray-50/50">
	<div class="container max-w-5xl">
		<!-- Section Header -->
		<div class="text-center mb-12">
			<h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
				See it in Action
			</h2>
			<p class="text-lg text-gray-600 max-w-2xl mx-auto">
				Watch how easy it is to share your favorite YouTube videos with friends
				using WatchThis!
			</p>
		</div>

		<!-- Video Container -->
		<div class="relative">
			<!-- Video Frame -->
			<div
				class="bg-white rounded-3xl shadow-2xl shadow-gray-200/50 border border-gray-100 overflow-hidden"
			>
				<!-- Responsive YouTube Embed -->
				<div class="aspect-video">
					<iframe
						src={`https://www.youtube.com/embed/${videoId}`}
						title="WatchThis! Demo Video"
						frameborder="0"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
						class="w-full h-full"></iframe>
				</div>
			</div>

			<!-- Decorative Elements -->
			<div
				class="absolute -z-10 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-primary/5 rounded-full blur-3xl"
			>
			</div>
		</div>
	</div>
</section>
