---
import { Icon } from "astro-icon/components";
---

<section
	id="pricing"
	class="py-24 bg-gradient-to-br from-primary via-primary to-primary-hover"
>
	<div class="container text-center">
		<h2 class="text-4xl sm:text-5xl font-bold text-white mb-6">
			Community Funded & Open Source
		</h2>

		<p class="text-lg text-white/90 mb-6 max-w-2xl mx-auto leading-relaxed">
			WatchThis! is completely free to use. I believe great tools should be
			accessible to everyone. The project is supported by my community through
			voluntary donations.
		</p>

		<p class="text-base text-white/80 mb-12 max-w-2xl mx-auto leading-relaxed">
			If community funding isn't enough to cover hosting costs, a Pro tier might
			be introduced in the future — but there will <strong class="text-white"
				>always</strong
			> be a generous free tier!
		</p>

		<!-- CTA Buttons -->
		<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
			<a
				href="https://ko-fi.com/lukasweihrauch"
				target="_blank"
				class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary font-semibold rounded-2xl shadow-lg hover:bg-gray-50 hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5"
			>
				<Icon name="lucide:heart" class="w-5 h-5 mr-2" />
				Support WatchThis! with your donation
			</a>
			<a
				href="https://github.com/l2xu/watch-this"
				target="_blank"
				class="inline-flex items-center justify-center px-6 py-3 bg-white/10 text-white font-medium rounded-xl border border-white/20 hover:bg-white/20 transition-all duration-300 hover:-translate-y-0.5"
			>
				<Icon name="simple-icons:github" class="w-5 h-5 mr-2" />
				View on GitHub
			</a>
		</div>
	</div>
</section>
