---
import { Icon } from "astro-icon/components";
import { translations } from "../utils/translations";

const t = translations.faqs;
const faqs = t.items;
---

<section id="faq" class="py-20 bg-gradient-to-b from-gray-50/30 to-white">
	<div class="container max-w-3xl">
		<!-- Section Header -->
		<div class="text-center mb-12">
			<!-- English Heading -->
			<h2 data-lang-en class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
				Frequently Asked Questions
			</h2>
			<!-- German Heading -->
			<h2 data-lang-de class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4 hidden">
				{t.sectionHeading.de}
			</h2>
			
			<!-- English Subheading -->
			<p data-lang-en class="text-lg text-gray-600">Got questions? I've got answers.</p>
			<!-- German Subheading -->
			<p data-lang-de class="text-lg text-gray-600 hidden">{t.sectionSubheading.de}</p>
		</div>

		<!-- FAQ Accordion -->
		<div class="space-y-4">
			{
				faqs.map((faq, index) => (
					<div class="faq-item bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300">
						<button
							class="faq-trigger w-full px-6 py-5 flex items-center justify-between text-left focus:outline-none"
							aria-expanded="false"
							data-index={index}
						>
							<span class="font-semibold text-gray-900 pr-4">
								<!-- English Question -->
								<span data-lang-en>{faq.question.en}</span>
								<!-- German Question -->
								<span data-lang-de class="hidden">{faq.question.de}</span>
							</span>
							<span class="faq-icon flex-shrink-0 w-8 h-8 bg-gray-100 rounded-xl flex items-center justify-center transition-all duration-300">
								<Icon
									name="lucide:chevron-down"
									class="w-5 h-5 text-gray-600 transition-transform duration-300"
								/>
							</span>
						</button>
						<div class="accordion-content">
							<div class="px-6 pb-5 pt-0">
								<!-- English Answer -->
								<p data-lang-en class="text-gray-600 leading-relaxed">{faq.answer.en}</p>
								<!-- German Answer -->
								<p data-lang-de class="text-gray-600 leading-relaxed hidden">{faq.answer.de}</p>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	const triggers = document.querySelectorAll(".faq-trigger");

	triggers.forEach((trigger) => {
		trigger.addEventListener("click", () => {
			const parent = trigger.parentElement;
			const content = parent?.querySelector(".accordion-content");
			const icon = trigger.querySelector(".faq-icon svg");
			const isOpen = content?.classList.contains("open");

			// Close all other items
			document
				.querySelectorAll(".accordion-content.open")
				.forEach((openContent) => {
					if (openContent !== content) {
						openContent.classList.remove("open");
						const openIcon =
							openContent.parentElement?.querySelector(".faq-icon svg");
						openIcon?.classList.remove("rotate-180");
						openContent.parentElement
							?.querySelector(".faq-trigger")
							?.setAttribute("aria-expanded", "false");
					}
				});

			// Toggle current item
			if (isOpen) {
				content?.classList.remove("open");
				icon?.classList.remove("rotate-180");
				trigger.setAttribute("aria-expanded", "false");
			} else {
				content?.classList.add("open");
				icon?.classList.add("rotate-180");
				trigger.setAttribute("aria-expanded", "true");
			}
		});
	});

	// Language toggle functionality
	import { getSavedLanguage, toggleLanguage } from "../utils/translations";

	// Listen to language change events from LanguageToggle
	window.addEventListener("languageChanged", ((event: CustomEvent) => {
		const { lang } = event.detail;
		toggleLanguage(lang);
	}) as EventListener);

	// Set initial state
	const currentLang = getSavedLanguage();
	toggleLanguage(currentLang);
</script>
