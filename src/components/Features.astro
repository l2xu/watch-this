---
const columns = [
  {
    title: "Requested",
    color: "bg-gray-100",
    dotColor: "bg-gray-400",
    cards: [
      {
        title: "Dark Mode Support",
        description: "Add a dark theme option for the extension popup and overlay.",
        tag: "Enhancement",
        tagColor: "bg-purple-100 text-purple-700",           
      },
    ],
  },
  {
    title: "In Progress",
    color: "bg-yellow-50",
    dotColor: "bg-yellow-400",
    cards: [
      {
        title: "Group Recommendations by Friend",
        description: "Group recommended videos on the startpage by the friend who shared them.",
        tag: "Feature",
        tagColor: "bg-blue-100 text-blue-700",
      },
    ],
  },
  {
    title: "Implemented",
    color: "bg-green-50",
    dotColor: "bg-green-400",
    cards: [
      {
        title: "One-Click Share",
        description: "Share any YouTube video with a single click directly from the video page.",
        tag: "Core",
        tagColor: "bg-primary/10 text-primary",
      },
         {
        title: "Display Recommendations on Feed",
        description: "Show recommended videos directly on the feed for easy access.",
        tag: "Core",
        tagColor: "bg-primary/10 text-primary",
      },
            {
        title: "Toggle Recommendations",
        description: "Easily show or hide the recommendations on the startpage.",
        tag: "Enhancement",
              tagColor: "bg-purple-100 text-purple-700",           

      },
    ],
  },
  
];
---

<section id="features" class="py-20 bg-gradient-to-b from-gray-50/50 via-gray-100/30 to-white">
  <div class="container">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        Feature Roadmap
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Track what I'm working on and what's coming next.</br> Have a suggestion? Let me know!
      </p>
    </div>

    <!-- Kanban Board -->
    <div class="grid md:grid-cols-3 gap-6">
      {columns.map((column) => (
        <div class="flex flex-col">
          <!-- Column Header -->
          <div class={`${column.color} rounded-2xl px-4 py-3 mb-4`}>
            <div class="flex items-center gap-2">
              <div class={`w-2.5 h-2.5 rounded-full ${column.dotColor}`}></div>
              <h3 class="font-semibold text-gray-800">{column.title}</h3>
              <span class="ml-auto text-sm text-gray-500 bg-white/80 px-2 py-0.5 rounded-lg">
                {column.cards.length}
              </span>
            </div>
          </div>

          <!-- Cards -->
          <div class="flex flex-col gap-4">
            {column.cards.map((card) => (
              <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-lg hover:border-gray-200 hover:-translate-y-1 transition-all duration-300 cursor-pointer group">
                <div class="flex items-start justify-between mb-3">
                  <span class={`text-xs font-medium px-2.5 py-1 rounded-lg ${card.tagColor}`}>
                    {card.tag}
                  </span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-300 group-hover:text-gray-400 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="1"/>
                    <circle cx="19" cy="12" r="1"/>
                    <circle cx="5" cy="12" r="1"/>
                  </svg>
                </div>
                <h4 class="font-semibold text-gray-900 mb-2 group-hover:text-primary transition-colors">
                  {card.title}
                </h4>
                <p class="text-sm text-gray-600 leading-relaxed">
                  {card.description}
                </p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
