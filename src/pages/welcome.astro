---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { translations } from "../utils/translations";

const t = translations.welcome;
---

<Layout>
	<!-- Hero Section -->
	<section
		class="pt-32 pb-12 bg-gradient-to-b from-white via-white to-gray-50/50"
	>
		<div class="container text-center">
			<div
				class="inline-flex items-center justify-center mb-6 px-4 py-2 bg-green-50 rounded-full border border-green-200"
			>
				<Icon name="lucide:check" class="w-5 h-5 mr-2 text-green-600" />
				<!-- English Badge -->
				<span data-lang-en class="text-green-700 font-semibold"
					>Extension Successfully Installed!</span
				>
				<!-- German Badge -->
				<span data-lang-de class="text-green-700 font-semibold hidden"
					>{t.successBadge.de}</span
				>
			</div>
			<!-- English Title -->
			<h1
				data-lang-en
				class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight"
			>
				Welcome to <span class="text-primary">WatchThis!</span>
			</h1>
			<!-- German Title -->
			<h1
				data-lang-de
				class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight hidden"
			>
				Willkommen bei <span class="text-primary">WatchThis!</span>
			</h1>
			<!-- English Subtitle -->
			<p
				data-lang-en
				class="text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed"
			>
				You're all set! Let's get you started with sharing YouTube videos the
				easy way.
			</p>
			<!-- German Subtitle -->
			<p
				data-lang-de
				class="text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed hidden"
			>
				{t.subtitle.de}
			</p>
		</div>
	</section>

	<!-- Donation Section -->
	<section class="py-24 bg-gradient-to-b from-gray-50/50 to-white">
		<div class="container">
			<div class="max-w-3xl mx-auto">
				<div
					class="bg-white rounded-3xl p-8 sm:p-12 shadow-xl border border-gray-100"
				>
					<!-- Heart Icon -->
					<div class="flex justify-center mb-6">
						<div
							class="w-16 h-16 bg-red-50 rounded-2xl flex items-center justify-center"
						>
							<Icon name="lucide:heart" class="w-8 h-8 text-primary" />
						</div>
					</div>

					<!-- Content -->
					<!-- English Heading -->
					<h2
						data-lang-en
						class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4 text-center"
					>
						Support WatchThis!
					</h2>
					<!-- German Heading -->
					<h2
						data-lang-de
						class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4 text-center hidden"
					>
						{t.donationHeading.de}
					</h2>
					<!-- English Description -->
					<p
						data-lang-en
						class="text-lg text-gray-600 mb-8 text-center leading-relaxed"
					>
						WatchThis! is completely free. If you enjoy using the extension and
						want to support its development, consider leaving a donation. Every
						contribution helps keep the project alive and growing!
					</p>
					<!-- German Description -->
					<p
						data-lang-de
						class="text-lg text-gray-600 mb-8 text-center leading-relaxed hidden"
					>
						{t.donationDescription.de}
					</p>

					<!-- Donation Button -->
					<div class="flex justify-center">
						<a
							href="https://ko-fi.com/lukasweihrauch"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-3 px-8 py-4 text-lg font-semibold text-white bg-primary hover:bg-primary-hover rounded-2xl shadow-lg shadow-primary/25 hover:shadow-xl hover:shadow-primary/30 transition-all duration-300 hover:-translate-y-0.5"
						>
							<Icon name="simple-icons:kofi" class="w-6 h-6" />
							<!-- English Button -->
							<span data-lang-en>Support on Ko-fi</span>
							<!-- German Button -->
							<span data-lang-de class="hidden">{t.ctaButton.de}</span>
						</a>
					</div>

					<!-- Thank You Note -->
					<!-- English Thank You -->
					<p data-lang-en class="text-sm text-gray-500 mt-8 text-center">
						Thank you for your support! 🙏
					</p>
					<!-- German Thank You -->
					<p data-lang-de class="text-sm text-gray-500 mt-8 text-center hidden">
						{t.thankYouNote.de}
					</p>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	import { getSavedLanguage, toggleLanguage } from "../utils/translations";

	// Listen to language change events from LanguageToggle
	window.addEventListener("languageChanged", ((event: CustomEvent) => {
		const { lang } = event.detail;
		toggleLanguage(lang);
	}) as EventListener);

	// Set initial state
	const currentLang = getSavedLanguage();
	toggleLanguage(currentLang);
</script>
