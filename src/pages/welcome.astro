---
import Layout from "../layouts/Layout.astro";

const steps = [
	{
		number: "1",
		title: "Create an Account",
		description: "Sign up in seconds and join the WatchThis! community. It's quick, easy, and completely free.",
		placeholder: "/placeholders/step-1-account.gif",
	},
	{
		number: "2",
		title: "Add Friends",
		description: "Connect with your friends using their unique username. Build your network and start sharing.",
		placeholder: "/placeholders/step-2-friends.gif",
	},
	{
		number: "3",
		title: "Send Videos",
		description: "Found an awesome video? Share it with a single click directly from any YouTube page.",
		placeholder: "/placeholders/step-3-send.gif",
	},
	{
		number: "4",
		title: "Receive Videos",
		description: "Your friends' recommendations appear right on your YouTube feed. No more missed videos!",
		placeholder: "/placeholders/step-4-receive.gif",
	},
];
---

<Layout>
	<!-- Hero Section -->
	<section class="pt-32 pb-12 bg-gradient-to-b from-white via-white to-gray-50/50">
		<div class="container text-center">
			<div class="inline-flex items-center justify-center mb-6 px-4 py-2 bg-green-50 rounded-full border border-green-200">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="w-5 h-5 mr-2 text-green-600"
					viewBox="0 0 24 24"
					fill="currentColor"
				>
					<path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path>
				</svg>
				<span class="text-green-700 font-semibold">Extension Successfully Installed!</span>
			</div>
			<h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight">
				Welcome to <span class="text-primary">WatchThis!</span>
			</h1>
			<p class="text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
				You're all set! Let's get you started with sharing YouTube videos the easy way.
			</p>
		</div>
	</section>

	<!-- Steps Section -->
	<section class="py-16 bg-gradient-to-b from-gray-50/50 to-white">
		<div class="container">
			<h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4 text-center">
				Get Started in 4 Simple Steps
			</h2>
			<p class="text-lg text-gray-600 mb-16 text-center max-w-2xl mx-auto">
				Follow these steps to start sharing and discovering amazing videos with your friends.
			</p>

			<!-- Steps Grid -->
			<div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
				{steps.map((step, index) => (
					<div class="group relative bg-white rounded-3xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 border border-gray-100">
						<!-- Step Number Badge -->
						<div class="absolute -top-4 -left-4 w-12 h-12 bg-primary text-white rounded-2xl flex items-center justify-center text-xl font-bold shadow-lg shadow-primary/25">
							{step.number}
						</div>

						<!-- Image/GIF Placeholder -->
						<div class="mb-6 mt-2 bg-gray-100 rounded-2xl overflow-hidden aspect-video flex items-center justify-center border-2 border-gray-200">
							<div class="text-center p-6">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="w-16 h-16 mx-auto mb-3 text-gray-400"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
								>
									<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
									<circle cx="8.5" cy="8.5" r="1.5"></circle>
									<polyline points="21 15 16 10 5 21"></polyline>
								</svg>
								<p class="text-sm text-gray-500 font-medium">GIF Placeholder</p>
								<p class="text-xs text-gray-400 mt-1">{step.placeholder}</p>
							</div>
						</div>

						<!-- Content -->
						<h3 class="text-2xl font-bold text-gray-900 mb-3">
							{step.title}
						</h3>
						<p class="text-gray-600 leading-relaxed">
							{step.description}
						</p>
					</div>
				))}
			</div>

			<!-- Quick Start Arrow/Connector for desktop -->
			<div class="hidden md:block absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none">
				<!-- You can add decorative arrows between steps here if desired -->
			</div>
		</div>
	</section>

	<!-- CTA Section - Support & Donate -->
	<section class="py-20 bg-gradient-to-br from-primary via-primary to-primary-hover">
		<div class="container text-center">
			<h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
				Love WatchThis!?
			</h2>
			<p class="text-lg text-white/90 mb-6 max-w-2xl mx-auto leading-relaxed">
				WatchThis! is completely free and always will be. If you enjoy using it, consider supporting the development with a small donation.
			</p>
			<p class="text-base text-white/80 mb-10 max-w-xl mx-auto">
				Your support helps keep the servers running and enables new features!
			</p>

			<!-- CTA Buttons -->
			<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
				<a
					href="https://ko-fi.com/lukasweihrauch"
					target="_blank"
					class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary font-semibold rounded-2xl shadow-lg hover:bg-gray-50 hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="w-5 h-5 mr-2"
						viewBox="0 0 24 24"
						fill="currentColor"
					>
						<path
							d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
						></path>
					</svg>
					Support the Development
				</a>
				<a
					href="/"
					class="inline-flex items-center justify-center px-6 py-3 bg-white/10 text-white font-medium rounded-xl border border-white/20 hover:bg-white/20 transition-all duration-300 hover:-translate-y-0.5"
				>
					Learn More About WatchThis!
				</a>
			</div>
		</div>
	</section>
</Layout>
